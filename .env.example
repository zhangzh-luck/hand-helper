# 单用户管理员。使用 `cd backend; .\.venv\Scripts\python.exe -m tools.generate_password_hash`
# 生成 Argon2id 哈希；不要提交真实密码、哈希或 Session Secret。
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
SESSION_MAX_AGE=1209600
# 本地 Vite（HTTP）为 false；部署到 HTTPS 域名时必须改为 true。
SESSION_COOKIE_SECURE=false
# 仅在后端不直接暴露公网，且 Nginx 已覆盖 X-Forwarded-For 时设为 true。
TRUST_PROXY_HEADERS=false
DATABASE_URL=sqlite+aiosqlite:///./data/ynnu_jw_helper.db
AUTO_CREATE_SCHEMA=false
CORS_ORIGINS=http://localhost:5173
WEB_APP_ORIGIN=http://localhost:5173
# 用于加密第三方模型 API Key；请使用 Fernet.generate_key() 生成，切勿提交真实值。
AI_CREDENTIAL_MASTER_KEY=
